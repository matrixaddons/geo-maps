# Development files kept out of the WordPress.org package.
# The readable JS/SCSS source (assets/src), package.json and webpack.config.js stay in.
.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig
.eslintignore
.eslintrc.json
.prettierignore
.prettierrc.json
.wordpress-org
.DS_Store
node_modules
tools
package-lock.json
README.md
*.zip
*.tar
tests
