{
	"name": "matrixmap",
	"version": "2.0.0",
	"private": true,
	"description": "MatrixMap - maps, store locator and interactive region maps for WordPress.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=assets/src/blocks --output-path=build",
		"start": "wp-scripts start --webpack-src-dir=assets/src/blocks --output-path=build",
