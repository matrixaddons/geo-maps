{
  "name": "geo-maps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "cross-env BUILD_TARGET=frontend webpack --config webpack.config.js && npm run build:scss:frontend",
    "build:admin": "cross-env BUILD_TARGET=admin webpack --config webpack.config.js && npm run build:scss:admin",
    "build:scss:frontend": "mkdir -p assets/build/css && rm -f assets/build/css/geo-maps* && sass assets/scss/geo-maps.scss:assets/build/css/geo-maps.css --style=compressed --source-map",
    "build:scss:admin": "mkdir -p assets/build/admin/css && rm -f assets/build/admin/css/*.css assets/build/admin/css/*.map && sass assets/scss/admin:assets/build/admin/css --style=compressed --source-map",
    "build:scss": "npm run build:scss:frontend && npm run build:scss:admin",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:md:js": "wp-scripts lint-md-js",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:frontend": "npm-run-all --parallel watch:scss-frontend watch:webpack-frontend",
    "watch:admin": "npm-run-all --parallel watch:scss-admin watch:webpack-admin",
    "watch:scss-frontend": "sass --watch assets/scss/geo-maps.scss:assets/build/css/geo-maps.css --style=compressed --source-map",
    "watch:scss-admin": "sass --watch assets/scss/admin:assets/build/admin/css --style=compressed --source-map",
    "watch:webpack": "cross-env BUILD_TARGET=all webpack --watch --config webpack.config.js",
    "watch:webpack-frontend": "cross-env BUILD_TARGET=frontend webpack --watch --config webpack.config.js",
    "watch:webpack-admin": "cross-env BUILD_TARGET=admin webpack --watch --config webpack.config.js"
  },
  "dependencies": {
    "@wordpress/compose": "^3.20.0",
    "@wordpress/i18n": "^3.15.0",
    "leaflet": "^1.7.1",
    "leaflet-geosearch": "^3.5.0",
    "node-bourbon": "^4.2.8",
    "npm": "^6.4.1",
    "react-leaflet": "^2.7.0",
    "react-leaflet-fullscreen": "^1.0.1",
    "typescript": "^4.5.2",
    "uglify": "^0.1.5"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^8.4.0",
    "@wordpress/blocks": "^11.4.0",
    "@wordpress/scripts": "^18.0.1",
    "autoprefixer": "~7.2.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "grunt": "^1.0.3",
    "grunt-checktextdomain": "^1.0.1",
    "grunt-contrib-compress": "^1.4.3",
    "grunt-contrib-concat": "~1.0.1",
    "grunt-contrib-cssmin": "^2.2.0",
    "grunt-contrib-jshint": "^1.1.0",
    "grunt-contrib-uglify": "^3.0.1",
    "grunt-contrib-watch": "^1.0.0",
    "grunt-fixmyjs": "^0.3.0",
    "grunt-phpcbf": "^0.1.1",
    "grunt-phpcs": "^0.4.0",
    "grunt-postcss": "~0.9.0",
    "grunt-rtlcss": "~2.0.1",
    "grunt-sass": "^3.1.0",
    "grunt-stylelint": "~0.9.0",
    "grunt-wp-i18n": "^1.0.3",
    "mini-css-extract-plugin": "2.4.5",
    "sass-loader": "^13.3.3",
    "webpack": "^5.99.5",
    "webpack-cli": "^5.1.4"
  }
}
